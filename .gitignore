# Stale timestamped backups of the front end — these were committed by accident
# and bloat the repo. The live file is index.html; recover old versions from git.
Cottage Holidays Blakeney/index.backup-*.html

# Photos uploaded at runtime via the Live Editor's file finder. Keep the folder
# and its guards (README + .htaccess) tracked, but not the user-uploaded content.
Cottage Holidays Blakeney/uploads/*
!Cottage Holidays Blakeney/uploads/README.txt
!Cottage Holidays Blakeney/uploads/.htaccess

# Optimised WebP copies generated next to source images at upload time.
Cottage Holidays Blakeney/*.webp

# Common local cruft
.DS_Store
Thumbs.db
node_modules/

# Playwright's manifest is a BUILD ARTIFACT here, not a project file: ci.yml runs
# `npm init -y` + `npm install playwright@<pinned>` in the app directory on every
# browser job, so a committed package.json would collide with the thing that
# creates it — and the deploy would carry it to the live host for no reason.
# Installing playwright locally to run the ui-test suites leaves these behind.
Cottage Holidays Blakeney/package.json
Cottage Holidays Blakeney/package-lock.json

# Layout-gate screenshots (regenerated per run; uploaded as a CI artifact).
Cottage Holidays Blakeney/layout-shots/

# PHPStan result cache (CI-persisted, never committed)
Cottage Holidays Blakeney/.phpstan-cache/

# The seeded design canvas is a BUILD ARTIFACT (~2.3MB — it embeds the whole
# canvas editor). The source is design/*.dc.html + canvas.json + build.mjs, and
# the published Artifact is the canonical copy; re-seed from the source.
design/*.html
!design/*.dc.html
